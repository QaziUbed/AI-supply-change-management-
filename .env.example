# Simple authentication (required in production)
SIMPLE_AUTH_EMAIL=admin@your-company.com
SIMPLE_AUTH_PASSWORD=change-this-password
SIMPLE_AUTH_ROLE=Planner
SIMPLE_AUTH_SESSION_SECRET=replace-with-a-long-random-secret

# AI (optional)
GEMINI_API_KEY=your-gemini-api-key-here

# Development fallback (when SIMPLE_AUTH_EMAIL/PASSWORD are unset in non-production):
# email: admin@example.com
# password: dev-password
